{
  "name": "ayu-sh-kr-portfolio",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:host": "vite --host",
    "lint": "tsc --noEmit",
    "lint:imports": "eslint .",
    "lint:fix": "eslint . --fix",
    "build": "tsc && vite build",
    "build:ssg": "tsc && vite build -- --ssg && node scripts/check-internal-links.mjs dist",
    "check:links": "node scripts/check-internal-links.mjs dist",
    "test": "vitest run",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@iconify-json/lucide": "1.2.139",
    "@iconify-json/material-symbols": "1.2.94",
    "@iconify-json/mdi": "1.2.3",
    "@iconify-json/ri": "1.2.10",
    "@iconify/utils": "3.1.7",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.4.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.12.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "happy-dom": "^20.12.0",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@ayu-sh-kr/dota-md": "^0.2.7",
    "@ayu-sh-kr/dota-ui": "^0.3.1",
